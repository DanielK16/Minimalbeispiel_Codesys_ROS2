# Autor: Daniel Körper
# Dockerfile um die Turtlebot4 Simulation in einem Container laufen zu lassen
# Mit ROS2 Jazzy läuft Simulation stabiler als mit humble! 
# Realer Turtlebot läuft mit ros2 humble
# Quellen:
# - https://github.com/kscottz/turtlebot4_docker/blob/2026/Dockerfile

# Basis Image für ros2 jazzy mit desktop anwendungen (rviz2, gazebo, rqt)
ARG ROS_DISTRO=jazzy
FROM osrf/ros:${ROS_DISTRO}-desktop
ARG ROS_DISTRO
ARG GZ_VERSION=harmonic

# Environment Variablen anlegen
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV DEBIAN_FRONTEND=noninteractive
ENV GZ_VERSION=${GZ_VERSION}

# Systeminstallation & Abhängigkeiten (als root)
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    sudo \
    wget \
    gnupg \
    python3-pip \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# Python OPC UA Packages installieren
RUN pip3 install asyncua --ignore-installed cryptography

# Install Gazebo Harmonic
RUN wget https://packages.osrfoundation.org/gazebo.gpg -O /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/gazebo-stable.list > /dev/null \
    && apt-get update \
    && apt-get install -y "gz-${GZ_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

# Install TB4 Simulator, ROS-Gz Bridge und Dev Tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    emacs \
    htop \
    byobu \
    python3-pip \
    less \
    && rm -rf /var/lib/apt/lists/*

# Anlegen eines non-root users
RUN id -u 1000 &>/dev/null && userdel -r $(getent passwd 1000 | cut -d: -f1) || true

ARG USERNAME=ros
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd -s /bin/bash --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && mkdir -p /home/$USERNAME/.config \
    && chown -R $USER_UID:$USER_GID /home/$USERNAME/.config

# Sudo-Rechte erteilen
RUN echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && usermod -aG video,dialout $USERNAME

# ROS 2 Umgebung automatisch in bashrc laden
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /home/$USERNAME/.bashrc

# Workspace vorbereiten und Quellcode clonen (als root, danach Rechte an ros übergeben)
RUN mkdir -p /home/$USERNAME/ros2_ws/src
WORKDIR /home/$USERNAME/ros2_ws/src
RUN git clone https://github.com/turtlebot/turtlebot4_simulator -b ${ROS_DISTRO}

WORKDIR /home/$USERNAME/ros2_ws/
RUN chown -R $USER_UID:$USER_GID /home/$USERNAME/ros2_ws

# Standard-User setzen für den finalen Build / Runtime
USER $USERNAME
WORKDIR /home/$USERNAME/ros2_ws

# Rosdep initialisieren und Abhängigkeiten für den Simulator installieren
RUN rosdep update && \
    sudo apt-get update && \
    . /opt/ros/${ROS_DISTRO}/setup.sh && \
    rosdep install --rosdistro ${ROS_DISTRO} -y --from-paths src --ignore-src

# Workspace kompilieren
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build --symlink-install

CMD ["bash"]