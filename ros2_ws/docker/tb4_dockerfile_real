# Autor: Daniel Körper
# Dockerfile um den realen Turtlebot4 aus einem Container zu steuern mittels zenoh 
# Realer Turtlebot läuft mir ros2 humble
# Quellen:
# - https://github.com/joshnewans/dockerfile_example/blob/main/Dockerfile
# - https://github.com/automaticaddison/mycobot_ros2/blob/lyrical/docker/Dockerfile#L31C26-L32C1

# Basis Image für ROS2 humble mit Desktop anwendungen (rviz2, gazebo, rqt)
ARG ROS_DISTRO=humble
FROM osrf/ros:${ROS_DISTRO}-desktop
ARG ROS_DISTRO

# Environment Variablen 
ENV PIP_BREAK_SYSTEM_PACKAGES=1         
ENV DEBIAN_FRONTEND=noninteractive      
ENV XDG_RUNTIME_DIR=/tmp/runtime-ros   
# ROS2 Variablen
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# System Abhängigkeiten und Basic Tools (als root installiert -> kein sudo nötig)
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    wget \
    apt-utils \
    curl \
    build-essential \
    python3-pip \
    python3-colcon-common-extensions && \
    rm -rf /var/lib/apt/lists/*

# Python OPC UA Packages 
RUN pip3 install asyncua --ignore-installed cryptography

# Packages for TB4 Simulator 
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Common TB4 Packages
    ros-${ROS_DISTRO}-turtlebot4-description \
    ros-${ROS_DISTRO}-turtlebot4-msgs \
    ros-${ROS_DISTRO}-turtlebot4-navigation \
    ros-${ROS_DISTRO}-turtlebot4-node \
    # TB4 Simulation
    ros-${ROS_DISTRO}-turtlebot4-simulator \
    ros-${ROS_DISTRO}-irobot-create-nodes \
    ros-dev-tools \
    # For Visualizing and Interfacing with Turtlebot from a PC
    ros-${ROS_DISTRO}-turtlebot4-desktop \
    # Lidar Drivers
    ros-${ROS_DISTRO}-rplidar-ros \
    # OAK D Camera Drivers
    ros-${ROS_DISTRO}-depthai-ros && \
    rm -rf /var/lib/apt/lists/*

# ROS2 Environment updaten
RUN rosdep update && \
    grep -F "source /opt/ros/${ROS_DISTRO}/setup.bash" /root/.bashrc || echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc && \
    grep -F "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" /root/.bashrc || echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" >> /root/.bashrc


# Anlegen eines non root users -> ros
# Alten ubuntu-User (UID 1000) entfernen, falls vorhanden
RUN id -u 1000 &>/dev/null && userdel -r $(getent passwd 1000 | cut -d: -f1) || true

ARG USERNAME=ros
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd -s /bin/bash --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && mkdir -p /home/$USERNAME/.config \
    && chown -R $USER_UID:$USER_GID /home/$USERNAME/.config

# sudo rechte erteilen
RUN echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && usermod -aG video,dialout $USERNAME

# ROS 2 Umgebung automatisch laden
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /home/$USERNAME/.bashrc

# Standard-User setzen 
USER $USERNAME
WORKDIR /home/$USERNAME

CMD ["bash"]